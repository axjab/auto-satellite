# Viewer API key: never give the broadcaster edit/delete permissions.
LUBELOGGER_URL=http://127.0.0.1:8080
LUBELOGGER_API_KEY=replace-with-viewer-key
NATS_URL=nats://127.0.0.1:4222

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
WEBHOOK_SECRET=replace-with-a-long-random-secret
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8090
SWEEP_SECONDS=900
LOG_LEVEL=INFO
